# Copy this file to .env and fill in your values.

# Home address shown in Home mode routes
VITE_HOME_ADDRESS=Your Home Address, Postcode

# National Rail API credentials (https://developer.nationalrail.co.uk/)
VITE_RDG_API_KEY=your_rdg_api_key

# TfL API key (https://api.tfl.gov.uk/)
VITE_TFL_API_KEY=your_tfl_api_key

# Google Maps JS API key — enable Maps JavaScript API, Directions API, Distance Matrix API
# https://console.cloud.google.com/ → APIs & Services → Credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Set to false to use the live API (default: true = offline demo data)
VITE_DUMMY_MODE=true
